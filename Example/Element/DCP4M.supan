element	DCP4M	1011	1084	1085	199	200	1	$cl $gf 50
element	DCP4M	1012	1085	1086	198	199	1	$cl $gf 50
element	DCP4M	1013	1086	1087	197	198	1	$cl $gf 50
element	DCP4M	1014	1087	1088	196	197	1	$cl $gf 50
element	DCP4M	1015	1088	1089	195	196	1	$cl $gf 50
element	DCP4M	1016	1089	1090	194	195	1	$cl $gf 50
element	DCP4M	1017	1090	1091	193	194	1	$cl $gf 50
element	DCP4M	1018	1091	1092	192	193	1	$cl $gf 50
element	DCP4M	1019	1092	1093	191	192	1	$cl $gf 50
element	DCP4M	1020	1093	1094	190	191	1	$cl $gf 50
element	DCP4M	1021	1094	1095	189	190	1	$cl $gf 50
element	DCP4M	1022	1095	1096	188	189	1	$cl $gf 50
