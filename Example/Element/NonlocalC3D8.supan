# A TEST MODEL FOR NONLOCALC3D8 MATERIAL

node 1 .5 -.5 -.5
node 2 .5 .5 -.5
node 3 -.5 .5 -.5
node 4 -.5 -.5 -.5
node 5 .5 -.5 .5
node 6 .5 .5 .5
node 7 -.5 .5 .5
node 8 -.5 -.5 .5

material NonlocalElastic3D 1 1E4 .2 1e1 1e-2

element NonlocalC3D8 1 1 2 3 4 5 6 7 8 1 1.

fix2 1 1 3 4 7 8
fix2 2 2 1 4 5 8
fix2 3 3 1 2 3 4

displacement 1 0 .4 3 5 6 7 8

hdf5recorder 1 Node RF3 7

step static 1
set fixed_step_size 1
set ini_step_size 1E-2
set symm_mat 0

converger AbsIncreDisp 1 1E-11 10 1

analyze

peek node 1 2 3 4 5 6 7 8

peek element 1

reset
clear
exit