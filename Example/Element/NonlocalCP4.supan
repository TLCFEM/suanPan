# A TEST MODEL FOR NONLOCALCP4 ELEMENT

node 1 0 0
node 2 2 0
node 3 4 0
node 4 6 0
node 5 8 0
node 6 10 0

node 7 0 2
node 8 2 2
node 9 4 2
node 10 6 2
node 11 8 2
node 12 10 2

material PlaneStress 1 2
material NonlocalElastic3D 2 1E4 .2 1e1 1e-2

element NonlocalCP4 1 1 2 8 7 1 1
element NonlocalCP4 2 2 3 9 8 1 1
element NonlocalCP4 3 3 4 10 9 1 1
element NonlocalCP4 4 4 5 11 10 1 1
element NonlocalCP4 5 5 6 12 11 1 1

fix 1 1 1 7
fix 2 2 1

disp 1 0 2 1 6 12

hdf5recorder 1 Sum RF1 6 12

step static 1
set fixed_step_size 1
set ini_step_size 1E-1

converger RelIncreDisp 1 1E-10 20 1

analyze

peek node 6 12

peek element 1

reset
clear
exit
